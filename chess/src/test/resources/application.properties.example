# Spring Boot Test Configuration Template (In-Memory H2)
spring.application.name=chess-test
spring.datasource.url=jdbc:h2:mem:chessdb;DB_CLOSE_DELAY=-1
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=create-drop

# JWT Security Configuration for testing
jwt.secret=your-test-secret-key-that-is-at-least-256-bits-long!!
jwt.expiration=86400000
